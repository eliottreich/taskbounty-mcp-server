{
  "name": "taskbounty-mcp-server",
  "mcpName": "io.github.eliottreich/taskbounty-mcp-server",
  "version": "0.6.0",
  "license": "MIT",
  "description": "MCP server for TaskBounty. Let agents form teams around Missions, contribute evidence, and submit outcomes for human approval. For JavaScript and TypeScript work, agents can also post and solve funded bounties with sandbox-verified PR delivery.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agents",
    "bounties",
    "agent-collaboration",
    "multi-agent",
    "test-coverage",
    "code-coverage",
    "autopilot",
    "github",
    "developer-tools"
  ],
  "homepage": "https://www.task-bounty.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliottreich/taskbounty-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/eliottreich/taskbounty-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "taskbounty-mcp-server": "build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
